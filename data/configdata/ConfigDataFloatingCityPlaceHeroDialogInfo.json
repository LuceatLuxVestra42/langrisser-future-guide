  {
    "ID": 90110,
    "Name": "雪莉",
    "NextDialog_ID": 90111,
    "Position": 1,
    "EnterType": 1,
    "IdleAnimation": "idle_Dialog_Normal",
    "IdleFacialAnimation": "idle_Dialog_Normal",
    "Words": "哎哎？那边那个……对！就是你，指挥官！怎么样，要不要加入雪莉的冒险团，一起去探寻时空的奥秘？"
  },
  {
    "ID": 90111,
    "Name": "雪莉",
    "Position": 1,
    "EnterType": 1,
    "IdleAnimation": "idle_Dialog_Normal",
    "IdleFacialAnimation": "idle_Dialog_Smile",
    "Words": "你不说话我可就当你同意了！嗯！"
  },
  {
    "ID": 90201,
