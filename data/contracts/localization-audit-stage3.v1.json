{
  "version": 1,
  "schemaId": "localization-audit-stage3-contract/v1",
  "stage": "3",
  "status": "FROZEN",
  "mode": "READ_ONLY_AUDIT",
  "purpose": "Extend the proven Soldier localization audit model to Hero and Equipment without reopening frozen semantics or production relations.",
  "inheritedSoldierGate": {
    "command": "node scripts/audit-localization-stage2-1.mjs --check",
    "expectedStatus": "PASS_WITH_REVIEW"
  },
  "hero": {
    "joinKey": "heroId",
    "joinPolicy": "exact numeric heroId only",
    "master": {
      "path": "data/hero-name-master.v1.json",
      "expectedRecordCount": 267,
      "requiredStatus": "verified"
    },
    "consumer": {
      "path": "data/generated/hero-list-stage1.v1.json",
      "expectedRecordCount": 267,
      "requiredSchemaId": "hero-list/v1",
      "requiredFreezeState": "HERO_LIST_STAGE1_FROZEN"
    },
    "fingerprintFields": [
      "heroId",
      "nameCn",
      "nameKr",
      "nameEn",
      "status"
    ]
  },
  "equipment": {
    "joinKey": "equipmentId",
    "joinPolicy": "audit final derived output by exact numeric equipmentId only; no runtime name join",
    "canonical": {
      "path": "data/generated/equipment_stage3_2_display_metadata.json",
      "expectedRecordCount": 390,
      "expectedPublicCount": 373,
      "expectedNonPublicCount": 17
    },
    "builder": {
      "path": "scripts/build-equipment-name-kr-presentation.mjs",
      "execution": "copy required inputs to OS temp directory and run there only",
      "repositoryWrites": false,
      "sourceFiles": [
        "data/localization/equipment-name-kr/weapon.tsv",
        "data/localization/equipment-name-kr/armor.tsv",
        "data/localization/equipment-name-kr/headgear.tsv",
        "data/localization/equipment-name-kr/accessory.tsv"
      ],
      "generatedOutput": "data/generated/equipment-name-kr-user-approved.v1.json",
      "generatedValidation": "data/validation/equipment-name-kr-user-approved-summary.v1.json",
      "requiredOutputStatus": "PASS_USER_APPROVED_EQUIPMENT_KR_PRESENTATION",
      "requiredPublicStatus": "USER_APPROVED_DISPLAY",
      "requiredNonPublicStatus": "UNRESOLVED_NON_PUBLIC"
    },
    "fingerprintFields": [
      "equipmentId",
      "nameCn",
      "nameKr",
      "pageReady",
      "status",
      "note"
    ]
  },
  "forbidden": [
    "automatic translation",
    "canonical identity mutation",
    "provisional promotion",
    "raw ConfigData reread",
    "relationship recomputation",
    "Hero joins by name or order",
    "Equipment audit joins by name after derived output is materialized",
    "repository writes during audit execution"
