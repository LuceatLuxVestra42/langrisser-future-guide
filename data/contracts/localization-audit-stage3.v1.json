  "completionGate": {
    "soldierStage2_1Passes": true,
    "hero267ExactIdParity": true,
    "heroAllVerifiedDisplayNames": true,
    "equipment390ExactIdParity": true,
    "equipmentPublic373DisplayNames": true,
