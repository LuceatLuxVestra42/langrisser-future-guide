  },
  "d1_0CompletionCriteria": [
    "exactly six initial diagnosis domains are defined",
    "each domain has one primaryStatusSource",
    "all primaryStatusSource files exist on the designed-against repository state",
    "expected canonical populations are explicit where supported",
    "lifecycle and health are separate normalized dimensions",
    "raw ConfigData and semantic recomputation are explicitly forbidden",
    "review and blocker behavior is explicit",
    "D1-1 can implement collection without inventing new semantic rules"
  ],
  "nextStage": "D1-1"
