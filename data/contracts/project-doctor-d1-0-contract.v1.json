        "general": "/population/general",
        "exclusive": "/population/exclusive",
        "hardErrorCount": "/hardErrorCount"
      },
      "reviewSelectors": [
        "/nonBlockingReviews"
      ],
      "nextWorkSelectors": [
        "/nextStartPoint"
      ],
      "lifecycleRules": [
        {
          "when": "/pipelineStatus == FINAL_FROZEN",
          "lifecycle": "FROZEN"
        },
        {
          "when": "/completion == COMPLETE",
          "lifecycle": "COMPLETE"
        }
      ],
      "supplementalSources": []
    },
