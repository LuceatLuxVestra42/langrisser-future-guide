{
  "version": 1,
  "schemaId": "project-doctor-d1-0-contract/v1",
  "stage": "D1-0",
  "checkpoint": "PROJECT_DOCTOR_D1_0_CONTRACT",
  "status": "DESIGN_FROZEN",
  "designedAgainst": {
    "branch": "main",
    "commit": "15125cb6c77386a726dfaeaa9ba674c0b320eaa9"
  },
  "purpose": "Freeze the read-only Project Doctor diagnosis contract: authoritative status sources, normalized output fields, and status interpretation rules. D1-0 does not execute validators, recalculate canonical semantics, or modify production data.",
  "scope": {
    "domains": [
      "hero",
      "soldier",
      "equipment",
      "hero-soldier",
      "banner",
      "skin"
    ],
    "included": [
      "authoritative status-source selection",
      "supplemental review-source selection",
      "normalized lifecycle/health model",
      "population and hard-error extraction contract",
      "review/blocker handling policy",
      "next-work passthrough policy"
    ],
    "excludedUntilLaterStages": [
      "validator execution",
      "git diff impact analysis",
      "dependency graph evaluation",
      "stale-output hash comparison",
      "frontend boundary source scanning",
      "package.json CLI wiring",
      "GitHub Actions integration",
      "automatic repository modification"
    ]
  },
  "operatingRules": {
    "readOnlyDiagnosis": true,
    "preferFinalOrFrozenCheckpoint": true,
    "doNotReadRawConfigDataForStatus": true,
    "doNotRecomputeCanonicalRelations": true,
    "doNotInferStatusFromFileNamesAlone": true,
    "doNotInferMissingFields": true,
    "presentationReviewDoesNotReopenFrozenSemantics": true,
    "inProgressBlockerDoesNotEqualFailedCheckpoint": true,
    "generatedArtifactsAreIntegrityEvidenceNotSemanticAuthority": true,
    "historicalCheckpointsAreNotPrimaryStatusSources": true
  },
  "sourceAuthorityOrder": [
    "domain primaryStatusSource",
    "domain supplementalSources explicitly listed in this contract",
    "generated/manifest artifacts referenced by an accepted primary checkpoint for existence or integrity only",
    "historical checkpoints for provenance only"
  ],
  "forbiddenStatusSources": [
    "data/configdata/**",
    "name-based JOIN results",
    "ID arithmetic inference",
    "frontend runtime recomputation",
    "unlisted historical validation checkpoints"
  ],
  "normalizedModel": {
    "lifecycleValues": [
      "FROZEN",
      "COMPLETE",
      "IN_PROGRESS",
      "UNKNOWN"
    ],
    "healthValues": [
      "PASS",
      "REVIEW",
      "FAIL",
      "MISSING",
      "INCONSISTENT",
      "UNKNOWN"
    ],
    "reviewScopes": [
      "semantic",
      "identity",
      "presentation",
      "localization",
      "asset",
      "frontend",
      "chronology",
      "source-evidence",
      "unknown"
    ],
    "domainRecordFields": [
      "domain",
      "lifecycle",
      "health",
      "rawStatus",
      "rawCompletion",
      "rawFreezeState",
      "population",
      "hardErrorCount",
      "reviewCount",
      "reviews",
      "blockers",
      "primarySource",
      "supplementalSources",
      "nextWork",
      "notes"
    ]
  },
  "globalHealthPrecedence": [
    {
      "order": 1,
      "health": "MISSING",
      "when": "primaryStatusSource does not exist or cannot be read"
    },
    {
      "order": 2,
      "health": "INCONSISTENT",
      "when": "primary source parses but required contract fields are missing, expected canonical population mismatches, or mutually authoritative values conflict"
    },
    {
      "order": 3,
      "health": "FAIL",
      "when": "an explicit hard error, failed required check, blocking semantic failure, or failed admission gate is present"
    },
    {
      "order": 4,
      "health": "REVIEW",
      "when": "no FAIL condition exists and the source explicitly reports non-blocking reviews, deferred non-errors, unresolved presentation metadata, or an expected evidence blocker for an in-progress stage"
    },
    {
      "order": 5,
      "health": "PASS",
      "when": "the accepted checkpoint reports success and no review/blocker signal remains"
    },
    {
      "order": 6,
      "health": "UNKNOWN",
      "when": "the available source does not support a safe classification"
    }
  ],
  "reviewPolicy": {
    "blockingReview": "A review is blocking only when the authoritative source explicitly marks it blocking or the owning stage contract classifies it as a hard gate.",
    "nonBlockingReview": "Presentation/localization/asset/frontend/chronology reviews remain REVIEW and must not mutate canonical identity, membership, ownership, or frozen lifecycle.",
    "reviewCountMeaning": "reviewCount counts review entries, not the sum of affected records, unless a future contract explicitly asks for affected-record totals.",
    "unknownReviewScope": "If a review code cannot be classified safely, preserve it with scope=unknown instead of guessing."
  },
  "nextWorkPolicy": {
    "mode": "PASSTHROUGH_ONLY",
    "rule": "D1 reads nextAction/nextStartPoint/nextStage only when explicitly present in an authoritative source. It must not invent a recommendation in D1-0/D1-1."
  },
  "domains": {
    "hero": {
      "primaryStatusSource": "data/validation/hero-stage6-4-final.v1.json",
      "expected": {
        "canonicalHeroCount": 267
      },
      "requiredSelectors": {
        "rawStatus": "/status",
        "rawCompletion": "/completion",
        "rawFreezeState": "/heroDataPipelineStatus",
        "canonicalHeroCount": "/summary/canonicalHeroCount",
        "hardErrorCount": "/summary/hardErrorCount"
      },
      "reviewSelectors": [
        "/nonBlockingReviews"
      ],
      "nextWorkSelectors": [
        "/nextStartPoint"
      ],
      "lifecycleRules": [
        {
          "when": "/heroDataPipelineStatus == FINAL_FROZEN",
          "lifecycle": "FROZEN"
        },
        {
          "when": "/completion == COMPLETE",
          "lifecycle": "COMPLETE"
        }
      ],
      "supplementalSources": []
    },
    "soldier": {
      "primaryStatusSource": "data/validation/soldier-stage6-7-site-admission.v1.json",
      "expected": {
        "canonicalSoldiers": 224,
        "normalSoldiers": 168,
        "spSoldiers": 56,
        "heroSoldierRelations": 5977
      },
      "requiredSelectors": {
        "rawStatus": "/status",
        "rawCompletion": "/admissionStatus",
        "canonicalSoldiers": "/coverage/canonicalSoldiers",
        "normalSoldiers": "/coverage/normalSoldiers",
        "spSoldiers": "/coverage/spSoldiers",
        "heroSoldierRelations": "/coverage/heroSoldierRelations",
        "hardErrorCount": "/checks/admissionGateFailures"
      },
      "zeroRequiredSelectors": [
        "/checks/upstreamStatusFailures",
        "/checks/sourceSnapshotMismatches",
        "/checks/coverageMismatches",
        "/checks/recordFailCount",
        "/checks/undeclaredReviewCodes",
        "/checks/representativeFailedFixtures",
        "/checks/filterFailedTests",
        "/checks/reciprocalPagePairMismatch",
        "/checks/expansionPreservationFailures",
        "/checks/documentationMissing",
        "/checks/admissionGateFailures"
      ],
      "reviewSelectors": [
        "/reviews"
      ],
      "lifecycleRules": [
        {
          "when": "/status == PASS AND /admissionStatus == READY_WITH_REVIEW",
          "lifecycle": "COMPLETE"
        }
      ],
      "supplementalSources": [
        {
          "path": "data/validation/soldier-t3-provisional-name-presentation.v1.json",
          "role": "CURRENT_PRESENTATION_REVIEW",
          "selectors": {
            "rawStatus": "/status",
            "normalTier3Count": "/canonical/normalTier3Count",
            "officialNameUnresolvedCount": "/canonical/officialNameUnresolvedCount",
            "provisionalDisplayCount": "/presentation/provisionalDisplayCount",
            "targets": "/targets"
          },
          "policy": "Presentation-only provisional names may add REVIEW items but cannot downgrade canonical Soldier identity/relation semantics to FAIL."
        }
      ]
    },
    "equipment": {
      "primaryStatusSource": "data/validation/equipment-stage4-final.v1.json",
      "expected": {
        "canonical": 390,
