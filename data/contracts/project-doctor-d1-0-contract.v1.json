  "d1_0CompletionCriteria": [
    "exactly six initial diagnosis domains are defined",
    "each domain has one canonical/lifecycle primaryStatusSource",
    "all listed primary and supplemental source files exist on the designed-against repository state",
    "expected canonical populations are explicit where supported",
    "lifecycle and health are separate normalized dimensions",
    "canonical lifecycle and scoped frontend/presentation facets are separated",
