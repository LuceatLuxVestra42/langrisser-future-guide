{
  "version": 1,
  "schemaId": "project-doctor-d1-0-contract/v1",
  "stage": "D1-0",
  "checkpoint": "PROJECT_DOCTOR_D1_0_CONTRACT",
  "status": "DESIGN_FROZEN",
  "designedAgainst": {
    "branch": "main",
    "commit": "15125cb6c77386a726dfaeaa9ba674c0b320eaa9"
  },
  "purpose": "Freeze the read-only Project Doctor diagnosis contract: authoritative status sources, normalized output fields, source-layer reconciliation rules, and status interpretation rules. D1-0 does not execute validators, recalculate canonical semantics, or modify production data.",
  "scope": {
    "domains": [
      "hero",
      "soldier",
      "equipment",
      "hero-soldier",
      "banner",
      "skin"
    ],
    "included": [
      "authoritative canonical/lifecycle source selection",
      "current frontend/presentation supplemental source selection",
      "normalized lifecycle/health model",
      "population and hard-error extraction contract",
      "review/blocker handling policy",
      "review freshness and supersession policy",
      "next-work passthrough policy"
    ],
    "excludedUntilLaterStages": [
      "validator execution",
      "git diff impact analysis",
      "dependency graph evaluation",
      "stale-output hash comparison",
      "frontend boundary source scanning",
      "package.json CLI wiring",
      "GitHub Actions integration",
      "automatic repository modification"
    ]
  },
  "operatingRules": {
    "readOnlyDiagnosis": true,
    "preferFinalOrFrozenCheckpoint": true,
    "primaryStatusSourceOwnsCanonicalLifecycle": true,
    "supplementalSourceCannotRewriteCanonicalLifecycle": true,
    "doNotReadRawConfigDataForStatus": true,
    "doNotRecomputeCanonicalRelations": true,
    "doNotInferStatusFromFileNamesAlone": true,
    "doNotInferMissingFields": true,
    "presentationReviewDoesNotReopenFrozenSemantics": true,
    "inProgressBlockerDoesNotEqualFailedCheckpoint": true,
    "generatedArtifactsAreIntegrityEvidenceNotSemanticAuthority": true,
    "historicalCheckpointsAreNotPrimaryStatusSources": true
  },
  "sourceAuthorityOrder": [
    "domain primaryStatusSource for canonical lifecycle and canonical population",
    "domain supplementalSources explicitly listed in this contract for scoped current frontend/presentation health",
    "generated/manifest artifacts referenced by an accepted checkpoint for existence or integrity only",
    "historical checkpoints for provenance only"
  ],
  "forbiddenStatusSources": [
    "data/configdata/**",
    "name-based JOIN results",
    "ID arithmetic inference",
    "frontend runtime recomputation",
    "unlisted historical validation checkpoints"
  ],
  "normalizedModel": {
    "lifecycleValues": [
      "FROZEN",
      "COMPLETE",
      "IN_PROGRESS",
      "UNKNOWN"
    ],
    "healthValues": [
      "PASS",
      "REVIEW",
      "FAIL",
      "MISSING",
      "INCONSISTENT",
      "UNKNOWN"
    ],
    "facets": [
      "canonical",
      "relation",
      "frontend",
      "asset",
      "localization",
      "chronology",
      "source-evidence"
    ],
    "reviewScopes": [
      "semantic",
      "identity",
      "presentation",
      "localization",
      "asset",
      "frontend",
      "chronology",
      "source-evidence",
      "unknown"
    ],
    "domainRecordFields": [
      "domain",
      "lifecycle",
      "health",
      "rawStatus",
      "rawCompletion",
      "rawFreezeState",
      "population",
      "hardErrorCount",
      "reviewCount",
      "reviews",
      "blockers",
      "facets",
      "primarySource",
      "supplementalSources",
      "nextWork",
      "notes"
    ],
    "hardErrorCountType": "integer-or-null"
  },
  "globalHealthPrecedence": [
    {
      "order": 1,
      "health": "MISSING",
      "when": "primaryStatusSource does not exist or cannot be read"
    },
    {
      "order": 2,
      "health": "FAIL",
      "when": "an explicit hard error, failed required check, blocking semantic failure, or failed admission gate is present"
    },
    {
      "order": 3,
      "health": "INCONSISTENT",
      "when": "primary source parses but required contract fields are missing, expected canonical population mismatches, or mutually authoritative values conflict without an explicit failed gate"
    },
    {
      "order": 4,
      "health": "REVIEW",
      "when": "no FAIL condition exists and a current source explicitly reports non-blocking reviews, deferred non-errors, unresolved presentation metadata, or an expected evidence blocker for an in-progress stage"
    },
    {
      "order": 5,
      "health": "PASS",
      "when": "the accepted checkpoint reports success and no current review/blocker signal remains"
    },
    {
      "order": 6,
      "health": "UNKNOWN",
      "when": "the available source does not support a safe classification"
    }
  ],
  "reviewPolicy": {
    "blockingReview": "A review is blocking only when the authoritative source explicitly marks it blocking or the owning stage contract classifies it as a hard gate.",
    "nonBlockingReview": "Presentation/localization/asset/frontend/chronology reviews remain REVIEW and must not mutate canonical identity, membership, ownership, or frozen lifecycle.",
    "reviewCountMeaning": "reviewCount counts current review entries, not the sum of affected records, unless a future contract explicitly asks for affected-record totals.",
    "unknownReviewScope": "If a review code cannot be classified safely, preserve it with scope=unknown instead of guessing."
  },
  "reviewReconciliationPolicy": {
    "rule": "A later supplemental source may supersede a primary-source review only when this contract explicitly lists the exact review code in supersedesPrimaryReviewCodes and the supplemental source directly verifies that scope.",
    "default": "PRESERVE_PRIMARY_REVIEW",
    "noImplicitFreshnessByCommitDate": true,
    "noImplicitSupersessionByStageNumber": true,
    "partialFrontendEvidence": "A PASS for one frontend facet such as list/detail projection or portrait coverage does not automatically clear unrelated route, hosted, mobile, localization, or asset reviews.",
    "resolvedReviewHandling": "A superseded review is omitted from current reviews but retained in provenance notes as historical/resolved."
  },
  "nextWorkPolicy": {
    "mode": "PASSTHROUGH_ONLY",
    "rule": "D1 reads nextAction/nextStartPoint/nextStage only when explicitly present in an authoritative source. It must not invent a recommendation in D1-0/D1-1."
  },
  "domains": {
    "hero": {
      "primaryStatusSource": "data/validation/hero-stage6-4-final.v1.json",
