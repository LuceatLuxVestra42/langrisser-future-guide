{
  "version": 1,
  "schemaId": "relation-delivery-contract/v1",
  "stage": "relation-delivery-A5",
  "status": "DESIGN_FROZEN",
  "purpose": "Extract only the delivery invariants proven by A1-A4 while leaving canonical identity, relation membership, provenance meaning, ordering semantics, and source authority with each owning domain.",
  "authorityBoundary": {
    "semanticAuthorityRemainsDomainOwned": true,
    "relationDeliveryIsSemanticAuthority": false,
    "relationDeliveryMayCreateEdges": false,
    "relationDeliveryMayRepairMissingEdges": false,
    "relationDeliveryMayInterpretNames": false,
    "relationDeliveryMayUseIdArithmetic": false,
    "genericGeneratedRelationArtifactAllowed": false
  },
  "lookupEnvelope": {
    "shape": {
      "present": "boolean",
      "targets": "readonly target[]"
    },
    "rules": [
      "present=false requires targets=[] and means the owning source has no key for the requested fromId.",
      "present=true may carry targets=[] and therefore preserves explicit empty-key semantics.",
      "targetId is mandatory and must be preserved exactly.",
      "fromId and targetId types are independent and may be number or string.",
      "Metadata is opaque to the shared layer and must be preserved according to the owning domain contract."
    ]
  },
  "projectionPolicy": {
    "sourceRule": "A projector reads only its declared frozen/generated owning relation authority. Lookup indexes may be validation oracles but may not be semantic inputs unless the owning domain explicitly declares them as authority.",
    "forbidden": [
      "raw ConfigData relation reread",
      "name JOIN",
      "filename similarity",
      "ID arithmetic",
      "missing-edge repair",
      "fallback relation synthesis",
      "manual pair insertion",
      "cross-domain semantic reinterpretation"
    ],
    "persistence": "DOMAIN_CHOICE_RUNTIME_OR_GENERATED",
    "genericSorting": "FORBIDDEN_UNLESS_OWNING_CONTRACT_REQUIRES_IT"
  },
  "metadataPolicy": {
    "sharedFields": [
      "targetId"
    ],
    "domainMetadata": "OPAQUE_EXACT_PRESERVATION",
    "provenance": "PRESERVE_FULL_STRUCTURE_WHEN_OWNING_RELATION_CARRIES_PROVENANCE",
    "order": "PRESERVE_OWNING_CONTRACT_ORDER_AND_ORDER_METADATA"
  },
