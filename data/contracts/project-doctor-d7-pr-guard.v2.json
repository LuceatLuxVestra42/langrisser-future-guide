{
  "version": 2,
  "schemaId": "project-doctor-d7-pr-guard/v2",
  "stage": "D7",
  "checkpoint": "PROJECT_DOCTOR_D7_PR_MERGE_GUARD_V2_LOCALIZATION",
  "status": "DESIGN_FROZEN",
  "supersedes": "data/contracts/project-doctor-d7-pr-guard.v1.json",
  "purpose": "Keep the existing read-only real-diff PR guard and prove that the current Doctor runtime uses D2/D3/D4 v2, selecting the frozen Localization Audit Stage 5 gate for localization-relevant changes without bypassing freshness or manual-review fail-closed behavior.",
  "workflow": ".github/workflows/project-doctor-d7-pr-guard.yml",
  "targetBaseBranch": "main",
  "checkIdentity": {"workflowName":"Project Doctor PR Guard","jobName":"pr-guard","requiredStatusCheckCandidate":"Project Doctor PR Guard / pr-guard"},
  "events": {"pull_request":{"branches":["main"],"types":["opened","synchronize","reopened","ready_for_review"]},"workflowDispatch":true,"pullRequestTargetForbidden":true},
  "runtime": {"runner":"ubuntu-latest","nodeVersion":"22","packageManager":"bun","install":"bun install --frozen-lockfile","checkoutFetchDepth":0},
  "permissions": {"contents":"read"},
  "changedFilePolicy": {"pullRequestBase":"origin/${github.event.pull_request.base.ref}","pullRequestHead":"github.event.pull_request.head.sha","comparison":"base...head","useRealChangedFiles":true,"representativePathOverride":false,"staleEventBaseShaForbidden":true,"unmappedPathBehavior":"MANUAL_REVIEW","manualReviewExitCode":3,"manualReviewMustFailWorkflow":true},
  "doctorRuntime": {"d2Contract":"data/contracts/project-doctor-d2-impact-contract.v2.json","d3Contract":"data/contracts/project-doctor-d3-validator-plan.v2.json","d4Contract":"data/contracts/project-doctor-d4-execution.v2.json","closeoutRunner":"scripts/run-project-doctor-closeout.mjs","d4Runner":"scripts/run-project-doctor-d4-v2.mjs"},
  "localizationIntegration": {"stage5Contract":"data/contracts/localization-audit-stage5.v1.json","stage6Contract":"data/contracts/localization-audit-stage6.v1.json","packageAlias":"audit:localization:check","packageCommand":"node scripts/audit-localization.mjs --check","d3CheckId":"localization-audit","phase":4,"requiredTriggerChangeClasses":["localization-tooling","presentation","frontend","frontend-consumer-data","semantic-data","raw-configdata"],"standaloneCiPreserved":true,"doctorExecutionRequiredForRelevantDiff":true},
  "requiredSteps": ["npm run doctor:pr-guard:validate","npm run doctor:freshness:validate","npm run doctor:status","git diff --exit-code -- data/generated/project-doctor-d1-1-status.v1.json data/validation/project-doctor-d1-1-summary.v1.json data/validation/project-doctor-d1-2-summary.v1.json","npm run doctor:freshness:validate","git fetch --no-tags origin $PR_BASE_REF","npm run doctor -- --dry-run --base $DOCTOR_BASE --head $DOCTOR_HEAD","npm run doctor -- --base $DOCTOR_BASE --head $DOCTOR_HEAD"],
  "securityPolicy": {"repositoryWritePermission":false,"freshnessRefreshInWorkflow":false,"pullRequestTarget":false,"secretsRequired":false,"forkCodeRunsWithWriteToken":false},
  "historicalBoundary": {"d3V1":"data/contracts/project-doctor-d3-validator-plan.v1.json","d4V1":"data/contracts/project-doctor-d4-execution.v1.json","regressionPromotionV1":"data/contracts/regression-coverage-promotion.v1.json","v1ContractsRemainUnmodified":true},
  "mergePolicy": {"workflowFailureBlocksRequiredCheckWhenConfigured":true,"manualReviewIsNonPassing":true,"staleFreshnessIsNonPassing":true,"validatorFailureIsNonPassing":true,"localizationAuditFailureIsNonPassing":true},
  "boundaries": {"rawConfigDataSemanticRecomputationAdded":false,"canonicalMutation":false,"frontendMutation":false,"freshnessAutoReseal":false,"missingOwningValidatorInvented":false,"canonicalOrRelationValidatorScopeBroadened":false,"localizationSemanticsChanged":false},
  "completionRule": "Stage 6 runtime proof requires an actual pull_request pr-guard run where the real Stage 6 diff selects and executes localization-audit through D3/D4 v2 and the job succeeds.",
  "nextStage": null
}
