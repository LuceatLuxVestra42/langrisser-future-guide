{
  "version": 1,
  "schemaId": "project-doctor-d7-pr-guard/v1",
  "stage": "D7",
  "checkpoint": "PROJECT_DOCTOR_D7_PR_MERGE_GUARD",
  "status": "DESIGN_FROZEN",
  "purpose": "Promote the proven read-only Project Doctor runtime into a pull-request-facing merge guard that evaluates the real PR diff, preserves D4 manual-review fail-closed behavior, and never reseals D5 freshness in CI.",
  "workflow": ".github/workflows/project-doctor-d7-pr-guard.yml",
  "targetBaseBranch": "main",
  "checkIdentity": {
    "workflowName": "Project Doctor PR Guard",
    "jobName": "pr-guard",
    "requiredStatusCheckCandidate": "Project Doctor PR Guard / pr-guard"
  },
  "events": {
    "pull_request": {
      "branches": ["main"],
      "types": ["opened", "synchronize", "reopened", "ready_for_review"]
    },
    "pushProofBranch": "work/project-doctor-closeout",
    "workflowDispatch": true,
    "pullRequestTargetForbidden": true
  },
  "runtime": {
    "runner": "ubuntu-latest",
    "nodeVersion": "22",
    "packageManager": "bun",
    "install": "bun install --frozen-lockfile",
    "checkoutFetchDepth": 0
  },
  "permissions": {
    "contents": "read"
  },
  "changedFilePolicy": {
    "pullRequestBase": "github.event.pull_request.base.sha",
    "pullRequestHead": "github.event.pull_request.head.sha",
    "comparison": "base...head",
    "pushProofBase": "origin/main",
    "pushProofHead": "HEAD",
    "useRealChangedFiles": true,
    "representativePathOverride": false,
    "unmappedPathBehavior": "MANUAL_REVIEW",
    "manualReviewExitCode": 3,
    "manualReviewMustFailWorkflow": true
  },
  "requiredSteps": [
    "npm run doctor:pr-guard:validate",
    "npm run doctor:freshness:validate",
    "npm run doctor:status",
    "git diff --exit-code -- data/generated/project-doctor-d1-1-status.v1.json data/validation/project-doctor-d1-1-summary.v1.json data/validation/project-doctor-d1-2-summary.v1.json",
    "npm run doctor:freshness:validate",
    "npm run doctor -- --dry-run --base $DOCTOR_BASE --head $DOCTOR_HEAD",
    "npm run doctor -- --base $DOCTOR_BASE --head $DOCTOR_HEAD"
  ],
  "securityPolicy": {
    "repositoryWritePermission": false,
    "freshnessRefreshInWorkflow": false,
    "pullRequestTarget": false,
    "secretsRequired": false,
    "forkCodeRunsWithWriteToken": false
  },
  "mergePolicy": {
    "workflowFailureBlocksRequiredCheckWhenConfigured": true,
    "manualReviewIsNonPassing": true,
    "staleFreshnessIsNonPassing": true,
    "validatorFailureIsNonPassing": true,
    "requiredStatusCheckConfigurationIsRepositoryAdminState": true
  },
  "repositoryEnforcement": {
    "rulesetObservedAtDesignTime": "NONE",
    "branchProtectionRead": "CONNECTOR_403",
    "requiredStatusCheckConfiguredByThisStage": false,
    "reason": "The available GitHub connector supports ruleset and branch-protection reads only; no ruleset or branch-protection mutation action is exposed. D7 can prove the PR check but cannot silently change repository admin enforcement settings."
  },
  "boundaries": {
    "rawConfigDataSemanticRecomputationAdded": false,
    "canonicalMutation": false,
    "frontendMutation": false,
    "freshnessAutoReseal": false,
    "missingOwningValidatorInvented": false,
    "validatorScopeBroadened": false
  },
  "completionRule": "D7 runtime guard proof requires an actual pull_request-triggered workflow run against main whose pr-guard job succeeds using the PR base/head comparison. Repository required-check enforcement is recorded separately because it is admin configuration, not workflow runtime proof.",
  "nextStage": "D7-ADMIN",
  "nextStageGoal": "If desired, configure the proven status check as required on main through repository ruleset or branch protection using an authorized admin surface."
}
