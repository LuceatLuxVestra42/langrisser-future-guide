{
  "version": 1,
  "schemaId": "project-doctor-status-source-artifact-bridge/v1",
  "stage": "PROJECT-STATUS-STAGE5",
  "checkpoint": "PROJECT_DOCTOR_STATUS_SOURCE_ARTIFACT_BRIDGE",
  "status": "DESIGN_FROZEN",
  "purpose": "Bind the six explicit Project Doctor domain completion/readiness artifact pipelines to the Stage 4 producer gate without inferring authority from filenames, stage numbers, chronology, or unmerged validator-owner work.",
  "producerContract": "data/contracts/project-doctor-status-source-producers.v1.json",
  "activeRegistry": "data/generated/project-doctor-active-source-registry.v1.json",
  "command": "node scripts/bridge-project-doctor-status-source.mjs --pipeline <pipeline-id> [--id <entry-id> --source <validated-json>] [--apply]",
  "policy": {
    "pipelineMustBeRegistered": true,
    "pipelineDomainMustMatchProducer": true,
    "baselineMustMatchActiveRegistryAtFreeze": true,
    "defaultMode": "CHECK_ONLY",
    "applyMustBeExplicit": true,
    "candidateAlwaysDelegatesToStage4ProducerGate": true,
    "stage4AlwaysDelegatesToStage3Admission": true,
    "doesNotExecuteOwningValidator": true,
    "doesNotInferOwningValidator": true,
    "doesNotInferAuthorityFromFilename": true,
    "doesNotInferAuthorityFromStageNumber": true,
    "doesNotInferAuthorityFromChronology": true,
    "preserveSourceStatusSemantics": true,
    "rawConfigDataRead": false,
    "semanticRecomputation": false,
    "canonicalJoinRecomputation": false
  },
  "pipelines": [
    {
      "id": "hero",
      "domain": "hero",
      "producerId": "hero-final",
      "baselineEntryId": "hero-stage6-4-final",
      "baselineSourcePath": "data/validation/hero-stage6-4-final.v1.json",
      "semanticRole": "CURRENT_FINAL_FROZEN"
    },
    {
      "id": "soldier",
      "domain": "soldier",
      "producerId": "soldier-final",
      "baselineEntryId": "soldier-stage6-7-site-admission",
      "baselineSourcePath": "data/validation/soldier-stage6-7-site-admission.v1.json",
      "semanticRole": "CURRENT_SITE_ADMISSION"
    },
    {
      "id": "equipment",
      "domain": "equipment",
      "producerId": "equipment-final",
      "baselineEntryId": "equipment-stage4-final",
      "baselineSourcePath": "data/validation/equipment-stage4-final.v1.json",
      "semanticRole": "CURRENT_FINAL_FROZEN"
    },
    {
      "id": "hero-soldier",
      "domain": "hero-soldier",
      "producerId": "hero-soldier-final",
      "baselineEntryId": "hero-soldier-stageC-final",
      "baselineSourcePath": "data/validation/hero-soldier-integration-stageC-final.v1.json",
      "semanticRole": "CURRENT_RELATION_FINAL_FROZEN"
    },
    {
      "id": "banner",
      "domain": "banner",
      "producerId": "banner-final",
      "baselineEntryId": "banner-stage3-8-regression-freeze",
      "baselineSourcePath": "data/validation/banner-stage3-8-regression-freeze-summary.v1.json",
      "semanticRole": "CURRENT_REGRESSION_FREEZE"
    },
    {
      "id": "skin",
      "domain": "skin",
      "producerId": "skin-final",
      "baselineEntryId": "skin-stage3-2-readiness",
      "baselineSourcePath": "data/validation/skin-stage3-2-readiness.v1.json",
      "semanticRole": "CURRENT_READINESS_ASSET_EVIDENCE_PENDING",
      "expectedSourceStatus": "READY_FOR_ASSET_EVIDENCE"
    }
  ],
  "boundaries": {
    "doesNotChangeStage3AdmissionRules": true,
    "doesNotChangeStage4ProducerRules": true,
    "doesNotPromoteOnArtifactCreationAlone": true,
    "doesNotReopenFrozenSemantics": true,
    "doesNotUpgradeSkinReadinessToFinal": true,
    "productionMutation": false,
    "canonicalMutation": false,
    "frontendMutation": false
  }
}
