{
  "version": 3,
  "schemaId": "project-doctor-d2-impact-contract/v3",
  "stage": "D2-IMPACT",
  "checkpoint": "PROJECT_DOCTOR_D2_IMPACT_CONTRACT_V3",
  "status": "DESIGN_FROZEN",
  "baseMap": "data/contracts/project-doctor-d2-dependency-map.v1.json",
  "supersedes": "data/contracts/project-doctor-d2-impact-contract.v2.json",
  "purpose": "Preserve the frozen D2 dependency map and all v2 overlays, then add only two explicit mappings required for Equipment Image Stage 3 closeout: Equipment image evidence belongs to equipment-assets, and Regression Coverage Promotion V2 belongs to project-doctor tooling. No impact node or propagation edge is added or rewritten.",
  "scope": {
    "changedFileInputResolution": true,
    "pathNormalization": true,
    "dependencyPropagation": true,
    "domainProjection": true,
    "gitDiffInspection": false,
    "validatorSelection": false,
    "validatorExecution": false,
    "rawConfigDataRead": false,
    "semanticRecomputation": false,
    "githubActions": false,
    "equipmentImageEvidenceOverlay": true,
    "regressionPromotionV2Overlay": true
  },
  "inputModes": {
    "argv": "npm run doctor:impact -- <repository-relative-path...>",
    "stdinLines": "newline-delimited repository-relative paths with --stdin",
    "stdinJson": "JSON array of repository-relative path strings with --stdin"
  },
  "normalizationPolicy": {
    "stripLeadingDotSlash": true,
    "convertBackslashToSlash": true,
    "collapseRepeatedSlash": true,
    "deduplicateNormalizedPaths": true,
    "rejectAbsolutePaths": true,
    "rejectParentTraversal": true
  },
  "statusPolicy": {
    "MAPPED": "Every normalized changed path maps to one or more direct impact nodes.",
    "MANUAL_REVIEW": "At least one valid repository-relative path has no approved map rule. Do not fan out to all domains or guess by filename similarity.",
    "INVALID_INPUT": "At least one supplied path is absolute, empty after normalization, or contains parent traversal."
  },
  "exitPolicy": {
    "MAPPED": 0,
    "MANUAL_REVIEW": 3,
    "INVALID_INPUT": 2
  },
  "pathRuleOverlays": [
    {
      "id": "soldier-webp-assets-post-map",
      "patterns": ["public/images/soldiers-webp/**"],
      "excludePatterns": [],
      "directNodes": ["soldier-assets"],
      "changeClass": "asset",
      "reason": "Post-map Soldier frontend closeout serves 224/224 lossless WebP derivatives while retaining PNG as authoritative source evidence. This is presentation-only and must not reopen Soldier canonical semantics."
    },
    {
      "id": "project-doctor-workflow-post-map",
      "patterns": [".github/workflows/project-doctor-*.yml"],
      "excludePatterns": [],
      "directNodes": ["project-doctor"],
      "changeClass": "tooling",
      "reason": "Project Doctor CI/PR workflow changes affect Doctor tooling only. They must be validated by Doctor self-tests but must not fan out into semantic domain recomputation."
    },
    {
      "id": "project-status-derived-sync",
      "patterns": ["scripts/build-project-status.mjs", ".github/workflows/project-status-sync.yml", "data/generated/project-status.v1.json", "PROJECT_STATUS.md"],
      "excludePatterns": [],
      "directNodes": ["project-doctor"],
      "changeClass": "tooling",
      "reason": "Project Status is a deterministic read-only projection of Project Doctor D1. Its builder, sync workflow, generated JSON, and human-readable Markdown are Doctor tooling only and must not reopen domain semantics."
    },
    {
      "id": "regression-coverage-promotion-v1-meta-contract",
      "patterns": ["data/contracts/regression-coverage-promotion.v1.json", "data/validation/regression-coverage-promotion-summary.v1.json", "scripts/validate-regression-coverage-promotion.mjs"],
      "excludePatterns": [],
      "directNodes": ["project-doctor"],
      "changeClass": "tooling",
      "reason": "Regression Coverage Promotion V1 is a Doctor meta-contract admission surface only. Mapping these exact V1 files to project-doctor does not promote or broaden any domain owning validator."
    },
    {
      "id": "localization-audit-stage6-integration",
      "patterns": ["data/contracts/localization-audit-*", "data/validation/localization-audit-*", "data/checkpoints/localization-audit-*", "scripts/audit-localization*", "scripts/validate-localization-audit-stage6.mjs", ".github/workflows/localization-audit.yml"],
      "excludePatterns": [],
      "directNodes": ["project-doctor"],
      "changeClass": "localization-tooling",
      "reason": "Localization Audit contracts, snapshots, checkpoints, runner chain, Stage 6 validator, and permanent CI are cross-domain localization tooling. They map to project-doctor without reopening canonical domain semantics; D3 selects the dedicated frozen localization check by this change class."
    },
    {
      "id": "equipment-image-evidence-closeout",
      "patterns": ["data/evidence/equipment-image-*"],
      "excludePatterns": [],
      "directNodes": ["equipment-assets"],
      "changeClass": "asset-pipeline",
      "reason": "Equipment image evidence records provenance and hosted/browser proof for the Equipment asset pipeline. It maps to equipment-assets and does not reopen Equipment canonical semantics."
    },
    {
      "id": "regression-coverage-promotion-v2-meta-contract",
      "patterns": ["data/contracts/regression-coverage-promotion.v2.json"],
      "excludePatterns": [],
      "directNodes": ["project-doctor"],
      "changeClass": "tooling",
      "reason": "Regression Coverage Promotion V2 explicitly records the scoped equipment-assets final-owner activation and is Project Doctor tooling metadata."
    }
  ],
  "overlayPolicy": {
    "reason": "D2-MAP v1 remains frozen. V3 carries forward all v2 overlays unchanged and adds only Equipment image evidence and Promotion V2 meta-contract path mappings. No impact node or propagation edge is added or rewritten.",
    "mayAddPathRulesOnly": true,
    "mayAddImpactNodes": false,
    "mayAddPropagationEdges": false,
    "mayRewriteBaseRules": false,
    "historicalV1V2Preserved": true
  },
  "fixtures": [
    {"id":"HERO_FRONTEND_ROUTE","paths":["src/routes/heroes_.$heroId.tsx"],"expectedStatus":"MAPPED","expectedDirectNodes":["hero-frontend"],"expectedDomains":["hero"]},
    {"id":"SOLDIER_WEBP_POST_MAP_OVERLAY","paths":["public/images/soldiers-webp/5102.webp"],"expectedStatus":"MAPPED","expectedDirectNodes":["soldier-assets"],"expectedDomains":["soldier"]},
    {"id":"PROJECT_DOCTOR_WORKFLOW_POST_MAP_OVERLAY","paths":[".github/workflows/project-doctor-d7-pr-guard.yml"],"expectedStatus":"MAPPED","expectedDirectNodes":["project-doctor"],"expectedDomains":[]},
    {"id":"PROJECT_STATUS_DERIVED_SYNC_OVERLAY","paths":["scripts/build-project-status.mjs",".github/workflows/project-status-sync.yml","data/generated/project-status.v1.json","PROJECT_STATUS.md"],"expectedStatus":"MAPPED","expectedChangedFileCount":4,"expectedDirectNodes":["project-doctor"],"expectedDomains":[]},
    {"id":"SOLDIER_CONFIGDATA_PROPAGATION","paths":["data/configdata/ConfigDataSoldierInfo.json"],"expectedStatus":"MAPPED","expectedDirectNodes":["soldier-canonical"],"expectedDomains":["hero","hero-soldier","soldier"]},
    {"id":"HERO_SOLDIER_SHARED_RELATION","paths":["data/validation/hero-soldier-integration-stageC-final.v1.json"],"expectedStatus":"MAPPED","expectedDirectNodes":["hero-soldier-relation"],"expectedDomains":["hero","hero-soldier","soldier"]},
    {"id":"EQUIPMENT_IMAGE_ASSET_PIPELINE","paths":["data/validation/equipment-image-stage0-summary.v1.json"],"expectedStatus":"MAPPED","expectedDirectNodes":["equipment-assets"],"expectedDomains":["equipment"]},
    {"id":"EQUIPMENT_IMAGE_BROWSER_EVIDENCE","paths":["data/evidence/equipment-image-stage3-browser-ui.v1.json"],"expectedStatus":"MAPPED","expectedDirectNodes":["equipment-assets"],"expectedDomains":["equipment"]},
    {"id":"UNKNOWN_CONFIGDATA_REQUIRES_REVIEW","paths":["data/configdata/ConfigDataUnknownFutureTable.json"],"expectedStatus":"MANUAL_REVIEW","expectedDirectNodes":[],"expectedDomains":[]},
    {"id":"PACKAGE_UNION_RULE","paths":["package.json"],"expectedStatus":"MAPPED","expectedDirectNodes":["project-doctor","shared-build"],"expectedDomains":["banner","equipment","hero","soldier"]},
    {"id":"LOCALIZATION_AUDIT_TOOLING_OVERLAY","paths":["scripts/audit-localization.mjs","data/contracts/localization-audit-stage5.v1.json"],"expectedStatus":"MAPPED","expectedChangedFileCount":2,"expectedDirectNodes":["project-doctor"],"expectedDomains":[]},
    {"id":"REGRESSION_COVERAGE_PROMOTION_V2","paths":["data/contracts/regression-coverage-promotion.v2.json"],"expectedStatus":"MAPPED","expectedChangedFileCount":1,"expectedDirectNodes":["project-doctor"],"expectedDomains":[]}
  ],
  "nextStage": "D3-V3",
  "nextStageGoal": "Select the scoped Equipment image final owner for equipment-assets while preserving every other manual-review boundary."
}
