{
  "version": 1,
  "schemaId": "status-source-promotion-compatibility/v1",
  "stage": "R1-2",
  "status": "DESIGN_FROZEN",
  "purpose": "Preserve only the source-compatibility surface previously consumed by Project Doctor promotion preflight, without importing Project Doctor or Project Status runtime. This contract gates whether a proposed primary status source can satisfy the already-frozen projection shape; it does not normalize lifecycle, reviews, blockers, or next work.",
  "migratedFrom": {
    "path": "data/contracts/project-doctor-d1-0-contract.v1.json",
    "gitBlobSha": "2cab75eae62dab0474bfc8cd19b164645acd4140",
    "fields": [
      "domains.*.expected",
      "domains.*.requiredSelectors",
      "domains.*.zeroRequiredSelectors",
      "domains.*.supplementalSources"
    ]
  },
  "policy": {
    "runtimeReadsLegacyD1": false,
    "runtimeReadsLegacyDoctor": false,
    "acceptedPrimaryRawStatus": "string starting with PASS, or READY_FOR_ASSET_EVIDENCE",
    "hardErrorCountMustBeZeroWhenNumeric": true,
    "errorsArrayMustBeEmptyWhenSelected": true,
    "failedCheckCountSelectorsMustBeZeroWhenNumeric": true,
    "requiredSelectorsMustResolve": true,
    "zeroRequiredSelectorsMustResolveAndEqualZero": true,
    "expectedValuesMustMatch": true,
    "supplementalSelectorsMustResolve": true,
    "projectionOverrideMerge": "shallow override of the frozen domain compatibility guard",
    "projectionOverrideAllowedKeys": [
      "primaryFacet",
      "expected",
      "requiredSelectors",
      "zeroRequiredSelectors",
      "reviewSelectors",
      "nextWorkSelectors",
      "lifecycleRules",
      "supplementalSources",
      "policy"
    ],
    "normalizationFieldsIgnoredByPromotionGuard": [
      "primaryFacet",
      "reviewSelectors",
      "nextWorkSelectors",
      "lifecycleRules",
      "policy"
    ],
    "rawConfigDataRead": false,
    "semanticRecomputation": false,
    "canonicalJoinRecomputation": false
  },
  "domains": {
    "hero": {
      "expected": {
        "canonicalHeroCount": 267
      },
      "requiredSelectors": {
        "rawStatus": "/status",
        "rawCompletion": "/completion",
        "rawFreezeState": "/heroDataPipelineStatus",
        "canonicalHeroCount": "/summary/canonicalHeroCount",
        "hardErrorCount": "/summary/hardErrorCount"
      },
