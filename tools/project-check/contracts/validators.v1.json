{
  "version": 1,
  "schemaId": "project-check-validator-catalog/v1",
  "stage": "R3",
  "status": "DESIGN_FROZEN",
  "purpose": "Freeze executable validator identities for NEW Project Check. Commands are explicit argv arrays; Project Check never constructs shell commands from changed paths.",
  "policy": {
    "shellExecution": false,
    "commandsMustBeCatalogued": true,
    "deduplicateByValidatorId": true,
    "sortByPhaseThenId": true,
    "preflightEntireQueueBeforeExecution": true,
    "failFastOnFirstNonZero": true,
    "manualReviewSurvivesSuccessfulValidators": true,
    "validatorMayNotMutateStatusSource": true,
    "validatorMayNotMutateProjectStatus": true,
    "legacyDoctorValidatorAllowed": false,
    "legacyD2D3D4D5D7Allowed": false
  },
  "validators": [
    {
      "id": "status-source-selection",
      "phase": 1,
      "executable": "node",
      "args": ["tools/status-source/test/current-main-parity.mjs"],
      "owner": "status-source",
      "coverage": "R1-1 selection parity and independence."
    },
    {
      "id": "status-source-promotion",
      "phase": 1,
      "executable": "node",
      "args": ["tools/status-source/test/promotion-parity.mjs"],
      "owner": "status-source",
      "coverage": "R1-2 promotion compatibility, check/apply and rollback."
    },
    {
      "id": "status-source-producer-gate",
      "phase": 1,
      "executable": "node",
      "args": ["tools/status-source/test/producer-gate-parity.mjs"],
