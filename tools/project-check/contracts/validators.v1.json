      "coverage": "R1-5 explicit declaration/closeout/CAS lifecycle."
    },
    {
      "id": "project-status-parity",
      "phase": 2,
      "executable": "node",
      "args": ["tools/project-status/test/current-parity.mjs"],
      "owner": "project-status",
      "coverage": "R2 six-domain normalization/projection parity and independence."
