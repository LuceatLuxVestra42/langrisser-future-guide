{
  "version": 1,
  "schemaId": "project-status-normalization/v1",
  "stage": "R2",
  "status": "DESIGN_FROZEN",
  "purpose": "Normalize project lifecycle, health, population, reviews, blockers, supplemental evidence, and next-work fields as a read-only consumer of the independent R1 Status Source selection. Project Status owns interpretation; Status Source owns source authority.",
  "predecessor": {
    "checkpoint": "PROJECT_TOOLING_STATUS_SOURCE_R1_COMPLETE",
    "contract": "data/contracts/project-tooling-status-source-r1-final.v1.json",
    "requiredStatus": "PASS",
    "requiredCompletion": "R1_STATUS_SOURCE_COMPLETE",
    "selector": "tools/status-source/lib/select-active-sources.mjs"
  },
  "migratedReference": {
    "legacyNormalizationContract": "data/contracts/project-doctor-d1-0-contract.v1.json",
    "legacyProjectionScript": "scripts/build-project-status.mjs",
    "referenceUseOnly": true,
    "runtimeDependency": false
  },
  "policy": {
    "readOnly": true,
    "sourceAuthorityComesOnlyFromR1Selection": true,
    "selectedProjectionOverrideMayRefineDomainSpec": true,
    "projectionOverrideMerge": "shallow override of the domain normalization spec",
    "primarySourceOwnsCanonicalLifecycle": true,
    "supplementalSourceCannotRewriteCanonicalLifecycle": true,
    "doNotReadLegacyActiveRegistry": true,
    "doNotReadLegacyD1GeneratedStatus": true,
    "doNotReadD5Freshness": true,
    "doNotReadProjectStatusMarkdownAsInput": true,
    "doNotReadRawConfigData": true,
    "doNotRecomputeCanonicalRelations": true,
    "doNotInferStatusFromFilenameStageOrChronology": true,
    "doNotExecuteDomainValidators": true,
    "inProgressEvidenceBlockerIsReviewNotFailure": true,
    "nextWorkPassthroughOnly": true
  },
  "normalizedModel": {
    "lifecycleValues": ["FROZEN", "COMPLETE", "IN_PROGRESS", "UNKNOWN"],
    "healthValues": ["PASS", "REVIEW", "FAIL", "MISSING", "INCONSISTENT", "UNKNOWN"],
    "reviewScopes": ["semantic", "identity", "presentation", "localization", "asset", "frontend", "chronology", "source-evidence", "unknown"]
  },
  "globalHealthPrecedence": ["MISSING", "FAIL", "INCONSISTENT", "REVIEW", "PASS", "UNKNOWN"],
  "domains": {
    "hero": {
      "primaryFacet": "canonical",
      "expected": {"canonicalHeroCount": 267},
      "requiredSelectors": {
        "rawStatus": "/status",
        "rawCompletion": "/completion",
        "rawFreezeState": "/heroDataPipelineStatus",
        "canonicalHeroCount": "/summary/canonicalHeroCount",
        "hardErrorCount": "/summary/hardErrorCount"
      },
      "zeroRequiredSelectors": [],
      "reviewSelectors": ["/nonBlockingReviews"],
      "nextWorkSelectors": ["/nextStartPoint"],
      "lifecycleRules": [
        {"when": "/heroDataPipelineStatus == FINAL_FROZEN", "lifecycle": "FROZEN"},
        {"when": "/completion == COMPLETE", "lifecycle": "COMPLETE"}
      ],
      "supplementalSources": [
        {
          "path": "data/validation/hero-list-stage4.v1.json",
          "role": "CURRENT_HERO_ROUTE_ASSET_PREFLIGHT",
          "facet": "frontend",
          "selectors": {
            "rawStatus": "/status",
            "rawCompletion": "/completion",
            "heroCount": "/summary/heroCount",
            "resolvedArtworkCount": "/summary/resolvedArtworkCount",
            "pendingArtworkCount": "/summary/pendingArtworkCount",
            "hardErrorCount": "/summary/hardErrorCount",
            "failures": "/failures"
          },
          "supersedesPrimaryReviewCodes": [],
          "policy": "List/detail route shell and Stage 4 preflight evidence; it cannot reopen or rewrite frozen Hero semantics."
        },
        {
          "path": "data/validation/hero-list-stage5.v1.json",
          "role": "CURRENT_HERO_DETAIL_FRONTEND_PROJECTION",
          "facet": "frontend",
          "selectors": {
            "rawStatus": "/status",
            "rawCompletion": "/completion",
            "heroCount": "/summary/heroCount",
            "soldierEdgeCount": "/summary/soldierEdgeCount",
            "missingShardCount": "/summary/missingShardCount",
            "parityMismatchCount": "/summary/parityMismatchCount"
          },
          "supersedesPrimaryReviewCodes": [],
          "policy": "Frontend projection evidence only; it does not define final asset, hosted, or mobile status."
        }
      ]
    },
    "soldier": {
      "primaryFacet": "canonical",
      "expected": {
        "canonicalSoldiers": 224,
        "normalSoldiers": 168,
        "spSoldiers": 56,
        "heroSoldierRelations": 5977
      },
      "requiredSelectors": {
        "rawStatus": "/status",
        "rawCompletion": "/admissionStatus",
        "canonicalSoldiers": "/coverage/canonicalSoldiers",
        "normalSoldiers": "/coverage/normalSoldiers",
        "spSoldiers": "/coverage/spSoldiers",
        "heroSoldierRelations": "/coverage/heroSoldierRelations",
        "hardErrorCount": "/checks/admissionGateFailures"
      },
      "zeroRequiredSelectors": [
        "/checks/upstreamStatusFailures",
        "/checks/sourceSnapshotMismatches",
        "/checks/coverageMismatches",
        "/checks/recordFailCount",
        "/checks/undeclaredReviewCodes",
        "/checks/representativeFailedFixtures",
        "/checks/filterFailedTests",
        "/checks/reciprocalPagePairMismatch",
        "/checks/expansionPreservationFailures",
        "/checks/documentationMissing",
        "/checks/admissionGateFailures"
      ],
      "reviewSelectors": ["/reviews"],
      "nextWorkSelectors": [],
      "lifecycleRules": [
        {"when": "/status == PASS AND /admissionStatus == READY_WITH_REVIEW", "lifecycle": "COMPLETE"}
      ],
      "supplementalSources": [
        {
          "path": "data/validation/soldier-portrait-stage3j-frontend-full.v1.json",
          "role": "CURRENT_SOLDIER_FRONTEND_PORTRAIT_COVERAGE",
          "facet": "asset",
          "selectors": {
            "rawStatus": "/status",
            "canonicalSoldierCount": "/coverage/canonicalSoldierCount",
            "portraitRecordCount": "/coverage/portraitRecordCount",
            "normalPortraitCount": "/coverage/normalPortraitCount",
            "spPortraitCount": "/coverage/spPortraitCount",
            "missingPortraitCount": "/coverage/missingPortraitCount",
            "verifiedAssetFileCount": "/coverage/verifiedAssetFileCount"
          },
          "supersedesPrimaryReviewCodes": [],
          "policy": "Portrait coverage evidence only; canonical Soldier identity and chronology remain owned by the primary source."
        },
        {
          "path": "data/validation/soldier-t3-provisional-name-presentation.v1.json",
          "role": "CURRENT_PRESENTATION_REVIEW",
          "facet": "localization",
          "selectors": {
            "rawStatus": "/status",
            "normalTier3Count": "/canonical/normalTier3Count",
            "officialNameUnresolvedCount": "/canonical/officialNameUnresolvedCount",
            "provisionalDisplayCount": "/presentation/provisionalDisplayCount",
            "targets": "/targets"
          },
          "supersedesPrimaryReviewCodes": [],
          "policy": "Presentation-only provisional names cannot mutate canonical Soldier identity or relation semantics."
        }
      ]
    },
    "equipment": {
      "primaryFacet": "canonical",
      "expected": {"canonical": 390, "public": 373, "general": 206, "exclusive": 167},
      "requiredSelectors": {
        "rawStatus": "/status",
        "rawCompletion": "/completion",
        "rawFreezeState": "/pipelineStatus",
        "canonical": "/population/canonical",
        "public": "/population/public",
        "general": "/population/general",
        "exclusive": "/population/exclusive",
        "hardErrorCount": "/hardErrorCount"
      },
      "zeroRequiredSelectors": [],
      "reviewSelectors": ["/nonBlockingReviews"],
      "nextWorkSelectors": [],
      "lifecycleRules": [
        {"when": "/pipelineStatus == FINAL_FROZEN", "lifecycle": "FROZEN"},
        {"when": "/completion == COMPLETE", "lifecycle": "COMPLETE"}
      ],
      "supplementalSources": []
    },
    "hero-soldier": {
      "primaryFacet": "relation",
      "expected": {"heroCount": 267, "soldierCount": 224, "canonicalPairCount": 5977},
      "requiredSelectors": {
        "rawStatus": "/status",
        "rawCompletion": "/completion",
        "rawFreezeState": "/pipelineStatus",
        "heroCount": "/summary/heroCount",
        "soldierCount": "/summary/soldierCount",
        "canonicalPairCount": "/summary/canonicalPairCount",
        "hardErrorCount": "/summary/hardErrorCount"
      },
      "zeroRequiredSelectors": [
        "/summary/c1AllPairDifferences",
        "/summary/c1UnknownOrDuplicateIdentityErrors",
        "/summary/c2StructuralIdentityErrors",
        "/summary/c3SemanticFixtureFailures",
        "/summary/c4BoundaryViolations",
        "/summary/failedCheckCount",
        "/summary/hardErrorCount"
      ],
      "reviewSelectors": ["/nonBlockingReviews"],
      "nextWorkSelectors": ["/nextStartPoint"],
      "lifecycleRules": [
        {"when": "/pipelineStatus == FINAL_FROZEN", "lifecycle": "FROZEN"},
        {"when": "/completion == COMPLETE", "lifecycle": "COMPLETE"}
      ],
      "supplementalSources": []
    },
    "banner": {
      "primaryFacet": "canonical",
      "expected": {"definitions": 77, "occurrences": 94},
      "requiredSelectors": {
        "rawStatus": "/status",
        "rawFreezeState": "/freezeState",
        "definitions": "/canonicalPopulation/definitions",
        "occurrences": "/canonicalPopulation/occurrences",
        "errors": "/errors"
      },
      "zeroRequiredSelectors": [],
      "reviewSelectors": ["/knownDeferredNonErrors"],
      "nextWorkSelectors": ["/nextStage"],
      "lifecycleRules": [
        {"when": "/freezeState == BANNER_STAGE3_FROZEN", "lifecycle": "FROZEN"}
      ],
      "supplementalSources": []
    },
    "skin": {
      "primaryFacet": "asset",
      "expected": {"skinCount": 540, "heroCount": 267, "stage31FailedCheckCount": 0, "stage32FailedCheckCount": 0},
      "requiredSelectors": {
        "rawStatus": "/status",
        "rawCompletion": "/completion",
        "stage32FailedCheckCount": "/metrics/failedCheckCount",
        "evidencePresent": "/evidence/present",
        "blocker": "/evidence/blocker"
      },
      "zeroRequiredSelectors": [],
      "reviewSelectors": ["/evidence"],
      "nextWorkSelectors": [],
      "lifecycleRules": [
        {"when": "/status == READY_FOR_ASSET_EVIDENCE AND /evidence/present == false", "lifecycle": "IN_PROGRESS"}
      ],
      "supplementalSources": [
        {
          "path": "data/validation/skin-stage3-1-final.v1.json",
          "role": "FROZEN_STAGE3_1_POPULATION_BASELINE",
          "facet": "asset",
          "selectors": {
            "rawStatus": "/status",
            "rawCompletion": "/completion",
            "skinCount": "/metrics/skinCount",
            "heroCount": "/metrics/heroCount",
            "failedCheckCount": "/metrics/failedCheckCount"
          },
          "supersedesPrimaryReviewCodes": [],
          "policy": "Frozen Stage 3-1 population baseline only; Stage 3-2 owns current asset-evidence readiness."
        }
      ]
    }
  }
}
